# PostgreSQL connection string
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://spendwise:spendwise@localhost:5432/spendwise

# JWT secret key for signing access tokens (use at least 32 characters)
JWT_SECRET_KEY=a-very-long-and-secure-secret-key-for-development-only-32-chars!

# JWT token expiration in minutes
JWT_EXPIRATION_MINUTES=60

# Application environment (development or production)
ENVIRONMENT=development
